[
  {
    "name": "theme_info",
    "theme_name": "REMI Equipo Médico",
    "theme_version": "1.0.0",
    "theme_author": "REMI Equipo Médico",
    "theme_documentation_url": "https://remiequipomedico.com",
    "theme_support_url": "https://remiequipomedico.com"
  },
  {
    "name": "Tipografía",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Fuente de títulos",
        "info": "Se usa en encabezados, precios y botones.",
        "default": "outfit_n7"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Fuente de textos",
        "info": "Se usa en párrafos, listas y formularios.",
        "default": "manrope_n4"
      }
    ]
  },
  {
    "name": "Marca y SEO",
    "settings": [
      {
        "type": "text",
        "id": "business_name",
        "label": "Nombre del negocio",
        "info": "Aparece en los datos que lee Google. Si lo dejas vacío se usa el nombre de la tienda.",
        "default": "REMI Equipo Médico"
      },
      {
        "type": "text",
        "id": "business_area",
        "label": "Zona de servicio",
        "info": "Ciudad o región a la que atiendes. Ayuda a aparecer en búsquedas locales.",
        "default": "Aguascalientes, México"
      },
      {
        "type": "text",
        "id": "business_opening_hours",
        "label": "Horario en formato para Google",
        "info": "Distinto al horario que se muestra en la página: Google necesita este formato exacto. Días: Mo, Tu, We, Th, Fr, Sa, Su. Separa varios rangos con coma.",
        "default": "Mo-Fr 09:00-19:00, Sa 09:00-14:00"
      },
      {
        "type": "select",
        "id": "business_price_range",
        "label": "Rango de precios",
        "info": "Indicador orientativo que muestra Google.",
        "default": "$$",
        "options": [
          { "value": "$", "label": "Económico ($)" },
          { "value": "$$", "label": "Medio ($$)" },
          { "value": "$$$", "label": "Alto ($$$)" }
        ]
      },
      {
        "type": "image_picker",
        "id": "logo_image",
        "label": "Logotipo",
        "info": "Se usa en el encabezado, el pie de página y los datos que lee Google. Si lo dejas vacío se usa el logo que ya trae el tema."
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Ícono de la pestaña del navegador. Imagen cuadrada de 96 × 96 px o más."
      },
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Imagen para compartir",
        "info": "Se muestra al compartir un enlace en WhatsApp, Facebook o X. Recomendado 1200 × 630 px."
      }
    ]
  },
