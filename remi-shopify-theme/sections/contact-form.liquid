<section class="section contact">
  <div class="container contact__grid">
    <div class="contact-info">
      <div class="contact-info__card">
        {% render 'icon', name: 'phone' %}
        <div>
          <h3>Llámanos o escribe por WhatsApp</h3>
          <p><a href="tel:{{ settings.contact_phone | remove: ' ' }}">{{ settings.contact_phone }}</a></p>
        </div>
      </div>

      <div class="contact-info__card">
        {% render 'icon', name: 'mail' %}
        <div>
          <h3>Escríbenos por correo</h3>
          <p><a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a></p>
        </div>
      </div>

      <div class="contact-info__card">
        {% render 'icon', name: 'location' %}
        <div>
          <h3>Visítanos</h3>
          <p>{{ section.settings.locations_text }}</p>
        </div>
      </div>

      <div class="contact-info__card">
        {% render 'icon', name: 'clock' %}
        <div>
          <h3>Horario de atención</h3>
          <p>{{ settings.contact_hours }}</p>
        </div>
      </div>

      <div class="contact-info__trust">
        {% render 'icon', name: 'shield' %}
        Tus datos están protegidos y solo se usan para darte seguimiento.
      </div>
    </div>

    <div class="contact-form card">
      {%- form 'contact', id: 'ContactForm' -%}
        {%- if form.posted_successfully? -%}
          <div class="contact-form__success">
            {% render 'icon', name: 'check-circle' %}
            <h3>¡Gracias por contactarnos!</h3>
            <p>{{ 'contact.form.success' | t }}</p>
          </div>
        {%- else -%}
          <h2>{{ 'contact.form.title' | t }}</h2>

          {%- if form.errors -%}
            <div class="field__error" style="margin-bottom:16px;">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div class="field">
            <label for="ContactFormName">{{ 'contact.form.name' | t }}</label>
            <input type="text" id="ContactFormName" name="contact[name]" required>
          </div>

          <div class="field-row">
            <div class="field">
              <label for="ContactFormEmail">{{ 'contact.form.email' | t }}</label>
              <input type="email" id="ContactFormEmail" name="contact[email]" value="{{ form.email }}" required>
            </div>
            <div class="field">
              <label for="ContactFormPhone">{{ 'contact.form.phone' | t }}</label>
              <input type="tel" id="ContactFormPhone" name="contact[phone]" required>
            </div>
          </div>

          <div class="field">
            <label for="ContactFormCategory">¿Qué equipo te interesa?</label>
            <select id="ContactFormCategory" name="contact[Categoría de interés]" required>
              <option value="" disabled selected>Selecciona una categoría</option>
              {%- for block in section.blocks -%}
                <option value="{{ block.settings.label }}">{{ block.settings.label }}</option>
              {%- endfor -%}
              <option value="Otro">Otro</option>
            </select>
          </div>

          <div class="field">
            <label for="ContactFormMessage">{{ 'contact.form.message' | t }}</label>
            <textarea id="ContactFormMessage" name="contact[body]" rows="4" placeholder="{{ 'contact.form.message_placeholder' | t }}" required></textarea>
          </div>

          <button type="submit" class="btn btn-accent contact-form__submit">{{ 'contact.form.send' | t }}</button>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Formulario de contacto",
  "settings": [
    { "type": "text", "id": "locations_text", "label": "Texto de sucursales", "default": "3 sucursales en Aguascalientes. Consulta la más cercana a ti." }
  ],
  "blocks": [
    {
      "type": "category_option",
      "name": "Opción de categoría",
      "settings": [
        { "type": "text", "id": "label", "label": "Nombre", "default": "Oxigenoterapia" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Formulario de contacto",
      "blocks": [
        { "type": "category_option", "settings": { "label": "Oxigenoterapia" } },
        { "type": "category_option", "settings": { "label": "Apnea del Sueño" } },
        { "type": "category_option", "settings": { "label": "Ortopedia" } },
        { "type": "category_option", "settings": { "label": "Equipo Médico" } },
        { "type": "category_option", "settings": { "label": "Reguladores" } },
        { "type": "category_option", "settings": { "label": "Renta en Aguascalientes" } }
      ]
    }
  ]
}
{% endschema %}
