<section class="section categories">
  <div class="container">
    <div class="section-head center">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="section-title">{{ section.settings.heading }}</h2>
      <p class="section-sub">{{ section.settings.text }}</p>
    </div>

    <div class="categories__grid">
      {%- for block in section.blocks -%}
        {%- if block.settings.collection != blank -%}
          {%- liquid
            # Imagen de la categoria: la del editor, si no la de la coleccion y,
            # en ultimo caso, la del primer producto de esa categoria que tenga foto.
            assign imagen_cat = block.settings.image
            unless imagen_cat
              assign imagen_cat = block.settings.collection.image
            endunless
            # `asset` gana sobre las automaticas pero no sobre la que suban al editor.
            unless imagen_cat
              for producto in block.settings.collection.products limit: 8
                if producto.featured_image
                  assign imagen_cat = producto.featured_image
                  break
                endif
              endfor
            endunless
            assign titulo_cat = block.settings.title | default: block.settings.collection.title
          -%}

          <a
            class="category-card{% if imagen_cat == blank and block.settings.asset == blank %} category-card--sin-imagen{% endif %}"
            href="{{ block.settings.collection.url }}"
            {{ block.shopify_attributes }}
          >
            <span class="category-card__frame">
            {%- if block.settings.image == blank and block.settings.asset != blank -%}
              <div class="category-card__media">
                <img
                  src="{{ block.settings.asset | asset_url }}"
                  alt="{{ titulo_cat | escape }}"
                  width="1110"
                  height="810"
                  loading="lazy"
                  decoding="async"
                >
              </div>
            {%- elsif imagen_cat -%}
              <div class="category-card__media">
                {% render 'responsive-image',
                   image: imagen_cat,
                   alt: titulo_cat,
                   sizes: '(max-width: 620px) 100vw, (max-width: 980px) 50vw, 370px',
                   widths: '370,555,740' %}
              </div>
            {%- endif -%}

            {%- comment -%}
              Sin titulo aqui: el nombre ya se muestra siempre debajo de la tarjeta
              y repetirlo a 40 px de distancia se veia redundante.
            {%- endcomment -%}
            <div class="category-card__info">
              <div class="category-card__icon">{% render 'icon', name: block.settings.icon %}</div>
              <p>{{ block.settings.text | default: block.settings.collection.description | strip_html | truncate: 110 }}</p>
              <span class="category-card__link">
                Ver productos
                {% render 'icon', name: 'arrow-right' %}
              </span>
            </div>
            </span>

            {%- comment -%}
              El nombre va fuera del marco, siempre visible: con la foto sola no
              se sabria de que categoria se trata hasta pasar el puntero.
            {%- endcomment -%}
            <span class="category-card__name">{{ titulo_cat }}</span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Cuadrícula de categorías",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto superior",
      "default": "Catálogo"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Equipo médico para cada necesidad"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Descripción",
      "default": "Explora nuestras categorías y encuentra el equipo adecuado para ti o para quien cuidas."
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoría",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Colección"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen de la categoría",
          "info": "Si la dejas vacía se usa la imagen de la colección y, si tampoco tiene, la del primer producto."
        },
        {
          "type": "text",
          "id": "asset",
          "label": "Archivo del tema",
          "info": "Nombre del archivo en assets, por ejemplo categoria-concentradores.jpg. Se usa si no subes una imagen arriba."
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Ícono",
          "default": "equipo-medico",
          "options": [
            {
              "value": "oxigenoterapia",
              "label": "Oxigenoterapia"
            },
            {
              "value": "apnea-del-sueno",
              "label": "Apnea del sueño"
            },
            {
              "value": "ortopedia",
              "label": "Ortopedia"
            },
            {
              "value": "equipo-medico",
              "label": "Equipo médico"
            },
            {
              "value": "reguladores",
              "label": "Reguladores"
            },
            {
              "value": "camas",
              "label": "Camas y colchones"
            },
            {
              "value": "ventilacion",
              "label": "Ventilación mecánica"
            },
            {
              "value": "renta",
              "label": "Renta"
            }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título (opcional, usa el de la colección si se deja vacío)"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Descripción (opcional)"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Cuadrícula de categorías",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "icon": "oxigenoterapia",
            "title": "Oxigenoterapia",
            "text": "Concentradores portátiles y estacionarios para terapia de oxígeno."
          }
        },
        {
          "type": "category",
          "settings": {
            "icon": "apnea-del-sueno",
            "title": "Apnea del Sueño",
            "text": "Equipos CPAP, BiPAP, mascarillas y accesorios para dormir mejor."
          }
        },
        {
          "type": "category",
          "settings": {
            "icon": "ortopedia",
            "title": "Ortopedia",
            "text": "Sillas de ruedas, andaderas, bastones y ayudas para movilidad."
          }
        },
        {
          "type": "category",
          "settings": {
            "icon": "equipo-medico",
            "title": "Equipo Médico",
            "text": "Camas clínicas, monitores y equipo esencial para el cuidado en casa."
          }
        },
        {
          "type": "category",
          "settings": {
            "icon": "reguladores",
            "title": "Reguladores",
            "text": "Reguladores de oxígeno de precisión, nuevos y de repuesto."
          }
        },
        {
          "type": "category",
          "settings": {
            "icon": "renta",
            "title": "Renta en Aguascalientes",
            "text": "Renta de equipo médico por día, semana o mes, con entrega local."
          }
        }
      ]
    }
  ]
}
{% endschema %}
