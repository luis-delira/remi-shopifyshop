<section class="section testimonials">
  <div class="container">
    <div class="section-head center">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="section-title">{{ section.settings.heading }}</h2>
    </div>

    {%- comment -%}
      Se muestran como maximo `max_visible` testimonios. Si hay mas, aparece el
      boton que lleva a la pagina con todos.
    {%- endcomment -%}
    {%- if section.settings.show_all -%}
      {%- assign visibles = section.blocks.size -%}
    {%- else -%}
      {%- assign visibles = section.settings.max_visible -%}
    {%- endif -%}

    <div class="testimonials__grid">
      {%- for block in section.blocks limit: visibles -%}
        <div class="testimonial-card" {{ block.shopify_attributes }}>
          <div class="testimonial-card__stars">
            {%- for i in (1..block.settings.rating) -%}
              {% render 'icon', name: 'star' %}
            {%- endfor -%}
          </div>
          <p>&ldquo;{{ block.settings.text }}&rdquo;</p>
          <div class="testimonial-card__author">
            <span class="testimonial-card__avatar">{{ block.settings.name | slice: 0, 1 }}</span>
            <div>
              <strong>{{ block.settings.name }}</strong>
              <span>{{ block.settings.role }}</span>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

    <div class="testimonials__actions">
      {%- if section.blocks.size > visibles and section.settings.all_link != blank -%}
        <a href="{{ section.settings.all_link }}" class="btn btn-outline">
          {{ section.settings.all_label }}
        </a>
      {%- endif -%}
      {%- if section.settings.review_link != blank -%}
        <a href="{{ section.settings.review_link }}" class="btn btn-primary">
          {{ section.settings.review_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonios",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto superior",
      "default": "Testimonios"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Familias que ya confían en nosotros"
    },
    {
      "type": "range",
      "id": "max_visible",
      "label": "Testimonios visibles",
      "min": 3,
      "max": 12,
      "step": 3,
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "show_all",
      "label": "Mostrar todos",
      "info": "Actívalo en la página de testimonios para que no se recorte la lista.",
      "default": false
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "Texto del botón 'ver más'",
      "default": "Ver más testimonios"
    },
    {
      "type": "url",
      "id": "all_link",
      "label": "Enlace a todos los testimonios"
    },
    {
      "type": "text",
      "id": "review_label",
      "label": "Texto del botón de reseña",
      "default": "Deja tu reseña"
    },
    {
      "type": "url",
      "id": "review_link",
      "label": "Enlace al formulario de reseña"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonio",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Nombre",
          "default": "Laura M."
        },
        {
          "type": "text",
          "id": "role",
          "label": "Ciudad",
          "default": "Aguascalientes, AGS"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Testimonio",
          "default": "Compré el CPAP para mi papá y la atención fue excelente desde la asesoría hasta la entrega."
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Calificación",
          "min": 1,
          "max": 5,
          "default": 5
        }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "Testimonios",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "name": "Laura M.",
            "role": "Aguascalientes, AGS",
            "text": "Compré el CPAP para mi papá y la atención fue excelente desde la asesoría hasta la entrega. Se nota que conocen bien los equipos.",
            "rating": 5
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "name": "Roberto S.",
            "role": "Guadalajara, JAL",
            "text": "Rentamos una cama clínica por dos meses y el proceso fue muy sencillo, con entrega puntual y equipo en perfectas condiciones.",
            "rating": 5
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "name": "Diana C.",
            "role": "Ciudad de México, CDMX",
            "text": "El envío llegó antes de lo esperado y el concentrador de oxígeno funciona perfecto. Definitivamente volvería a comprar con ellos.",
            "rating": 5
          }
        }
      ]
    }
  ]
}
{% endschema %}
