<section class="cta-banner">
  <div class="container cta-banner__inner">
    <div>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
    </div>
    <div class="cta-banner__actions">
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="btn btn-accent">{{ section.settings.button_label }}</a>
      {%- endif -%}
      {%- assign wa_text = settings.whatsapp_message | url_encode -%}
      <a href="https://wa.me/{{ settings.whatsapp_number }}?text={{ wa_text }}" target="_blank" rel="noopener" class="btn btn-ghost-light">
        Escribir por WhatsApp
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Banner de acción",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "¿Listo para encontrar el equipo médico ideal?" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Escríbenos hoy y recibe asesoría personalizada sin costo, en minutos." },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Solicitar cotización" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" }
  ],
  "presets": [{ "name": "Banner de llamada a la acción" }]
}
{% endschema %}
