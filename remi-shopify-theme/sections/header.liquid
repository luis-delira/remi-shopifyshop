{%- comment -%}
  Encabezado centrado en dos filas:
    fila 1  buscador | marca (centrada) | carrito
    fila 2  navegacion centrada + boton de cotizacion
  Los enlaces del menu que tengan subenlaces se muestran como desplegable.
{%- endcomment -%}

{%- assign header_logo = section.settings.logo | default: settings.logo_image -%}

<header class="nav">
  <div class="container nav__top">
    <form class="nav__search" action="{{ routes.search_url }}" method="get" role="search">
      <label class="visually-hidden" for="NavSearch">{{ 'general.search.placeholder' | t }}</label>
      <span class="nav__search-icon" aria-hidden="true">{% render 'icon', name: 'search' %}</span>
      <input
        id="NavSearch"
        class="nav__search-input"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'general.search.placeholder' | t }}"
        autocomplete="off"
      >
      <input type="hidden" name="type" value="product">
      <button type="submit" class="visually-hidden">{{ 'general.search.submit' | t }}</button>
    </form>

    <a href="{{ routes.root_url }}" class="nav__brand">
      {%- if header_logo -%}
        <img class="nav__logo" src="{{ header_logo | image_url: width: 120 }}" alt="{{ shop.name }}" width="60" height="60">
      {%- else -%}
        <img class="nav__logo" src="{{ 'logo.png' | asset_url }}" alt="{{ shop.name }}" width="60" height="60">
      {%- endif -%}
      <span class="nav__brand-text">{{ section.settings.brand_prefix }} <strong>{{ section.settings.brand_suffix }}</strong></span>
    </a>

    <div class="nav__actions">
      {%- comment -%}
        Selector de moneda. Shopify liga la moneda al pais del comprador, asi que
        el formulario envia country_code y se muestra el codigo de su moneda.
        Solo aparece si hay mas de un pais activo en Configuracion -> Mercados.
      {%- endcomment -%}
      {%- if section.settings.show_currency and localization.available_countries.size > 1 -%}
        <form method="post" action="{{ routes.root_url }}localization" id="HeaderCurrency" accept-charset="UTF-8" class="nav__currency" enctype="multipart/form-data">
          <input type="hidden" name="form_type" value="localization">
          <input type="hidden" name="utf8" value="✓">
          <input type="hidden" name="_method" value="put">
          <input type="hidden" name="return_to" value="{{ request.path }}">
          <label class="visually-hidden" for="HeaderCurrencySelect">{{ 'general.currency.label' | t }}</label>
          <select id="HeaderCurrencySelect" name="country_code" data-currency-select>
            {%- for country in localization.available_countries -%}
              <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>
                {{ country.currency.iso_code }}
              </option>
            {%- endfor -%}
          </select>
        </form>
      {%- endif -%}

      {%- comment -%}
        Acceso a asesoria por WhatsApp. Vive en la fila superior, que es la que
        permanece fija al hacer scroll, asi que sigue visible con el encabezado
        comprimido (ahi se reduce a icono + una linea).
      {%- endcomment -%}
      {%- if settings.whatsapp_number != blank -%}
        {%- assign wa_asesoria = section.settings.whatsapp_message | default: settings.whatsapp_message -%}
        <a
          class="nav__wa"
          href="https://wa.me/{{ settings.whatsapp_number }}?text={{ wa_asesoria | url_encode }}"
          target="_blank"
          rel="noopener"
        >
          <span class="nav__wa-icon">{% render 'icon', name: 'whatsapp' %}</span>
          <span class="nav__wa-text">
            <strong>{{ section.settings.whatsapp_title }}</strong>
            <span>{{ section.settings.whatsapp_subtitle }}</span>
          </span>
          <span class="nav__wa-short">{{ section.settings.whatsapp_short }}</span>
        </a>
      {%- endif -%}

      <a href="{{ routes.cart_url }}" class="nav__cart" aria-label="{{ 'cart.general.title' | t }}">
        {% render 'icon', name: 'cart' %}
        {%- if cart.item_count > 0 -%}
          <span class="nav__cart-count">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>

      <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="NavLinks" aria-label="{{ 'accessibility.menu' | t }}">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="container nav__bottom">
    <nav class="nav__links" id="NavLinks">
      {%- comment -%}
        El menu se arma con los bloques de esta seccion. Si se borran todos,
        cae de vuelta al menu de Navegacion de Shopify (ajuste "Menu de navegacion"),
        que tambien soporta desplegables si el enlace tiene subenlaces.
      {%- endcomment -%}

      {%- if section.blocks.size > 0 -%}
        {%- assign posiciones = '1,2,3,4,5,6' | split: ',' -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'dropdown' -%}
            <div class="nav__item" data-dropdown {{ block.shopify_attributes }}>
              <button type="button" class="nav__link nav__link--toggle" aria-expanded="false" data-dropdown-toggle>
                {{ block.settings.label }}
                {% render 'icon', name: 'chevron-down' %}
              </button>
              <div class="nav__dropdown" data-dropdown-panel>
                {%- for n in posiciones -%}
                  {%- assign clave_texto = 'child_' | append: n | append: '_label' -%}
                  {%- assign clave_url = 'child_' | append: n | append: '_url' -%}
                  {%- assign texto = block.settings[clave_texto] -%}
                  {%- if texto != blank -%}
                    <a href="{{ block.settings[clave_url] | default: '#' }}">{{ texto }}</a>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          {%- else -%}
            <a href="{{ block.settings.url | default: '#' }}" class="nav__link" {{ block.shopify_attributes }}>
              {{ block.settings.label }}
            </a>
          {%- endif -%}
        {%- endfor -%}

      {%- else -%}
        {%- for link in section.settings.menu.links -%}
          {%- if link.links.size > 0 -%}
            <div class="nav__item" data-dropdown>
              <button
                type="button"
                class="nav__link nav__link--toggle{% if link.child_active %} active{% endif %}"
                aria-expanded="false"
                data-dropdown-toggle
              >
                {{ link.title }}
                {% render 'icon', name: 'chevron-down' %}
              </button>
              <div class="nav__dropdown" data-dropdown-panel>
                {%- for child in link.links -%}
                  <a href="{{ child.url }}"{% if child.active %} class="active"{% endif %}>{{ child.title }}</a>
                {%- endfor -%}
              </div>
            </div>
          {%- else -%}
            <a href="{{ link.url }}" class="nav__link{% if link.active %} active{% endif %}">{{ link.title }}</a>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

      {%- if section.settings.cta_label != blank -%}
        <a href="{{ pages[section.settings.contact_page].url | default: '/pages/contacto' }}" class="btn btn-accent btn-sm nav__cta">
          {{ section.settings.cta_label }}
        </a>
      {%- endif -%}
    </nav>
  </div>
</header>

{% schema %}
{
