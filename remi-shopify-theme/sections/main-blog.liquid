<section class="catalog-hero">
  <div class="container">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h1>{{ blog.title }}</h1>
    {%- if section.settings.subtitle != blank -%}
      <p>{{ section.settings.subtitle }}</p>
    {%- endif -%}
  </div>
</section>

<section class="section blog-list">
  <div class="container">
    {%- if blog.all_tags.size > 0 and section.settings.show_tags -%}
      <div class="catalog__filters">
        <a href="{{ blog.url }}" class="filter-chip{% unless current_tags %} active{% endunless %}">
          {{ 'blogs.general.all_topics' | t }}
        </a>
        {%- for tag in blog.all_tags -%}
          <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="filter-chip{% if current_tags contains tag %} active{% endif %}">
            {{ tag }}
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- paginate blog.articles by section.settings.articles_per_page -%}
      {%- if blog.articles.size > 0 -%}
        <div class="blog-grid">
          {%- for article in blog.articles -%}
            <article class="article-card">
              <a class="article-card__media" href="{{ article.url }}">
                {%- if article.image -%}
                  {% render 'responsive-image',
                     image: article.image,
                     alt: article.title,
                     sizes: '(max-width: 700px) 100vw, 380px',
                     widths: '380,570,760' %}
                {%- else -%}
                  <div class="icon-placeholder">{% render 'icon', name: 'equipo-medico' %}</div>
                {%- endif -%}
              </a>

              <div class="article-card__body">
                <div class="article-card__meta">
                  <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                    {{ article.published_at | date: '%d %b %Y' }}
                  </time>
                  {%- if article.tags.size > 0 -%}
                    <span class="badge badge-teal">{{ article.tags.first }}</span>
                  {%- endif -%}
                </div>
                <h2><a href="{{ article.url }}">{{ article.title }}</a></h2>
                <p>{{ article.excerpt_or_content | strip_html | truncate: 130 }}</p>
                <a href="{{ article.url }}" class="category-card__link">
                  {{ 'blogs.general.read_more' | t }}
                  {% render 'icon', name: 'arrow-right' %}
                </a>
              </div>
            </article>
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <div class="pagination">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">&larr;</a>{%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}">{{ part.title }}</a>
              {%- else -%}
                <span class="current">{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}">&rarr;</a>{%- endif -%}
          </div>
        {%- endif -%}
      {%- else -%}
        <div class="empty-state">
          <p>{{ 'blogs.general.no_articles' | t }}</p>
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Consejos de salud" },
    { "type": "text", "id": "subtitle", "label": "Subtítulo", "default": "Guías prácticas sobre oxigenoterapia, apnea del sueño y cuidado en casa." },
    { "type": "checkbox", "id": "show_tags", "label": "Mostrar filtros por tema", "default": true },
    { "type": "range", "id": "articles_per_page", "label": "Artículos por página", "min": 3, "max": 24, "step": 3, "default": 9 }
  ]
}
{% endschema %}
