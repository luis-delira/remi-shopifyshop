<nav class="breadcrumbs container" aria-label="{{ 'general.breadcrumbs.label' | t }}">
  <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a>
  <span aria-hidden="true">/</span>
  <a href="{{ blog.url }}">{{ blog.title }}</a>
  <span aria-hidden="true">/</span>
  <span aria-current="page">{{ article.title }}</span>
</nav>

<article class="article">
  <header class="article__header container">
    <div class="article__meta">
      <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
        {{ article.published_at | date: '%d de %B de %Y' }}
      </time>
      {%- if section.settings.show_author and article.author != blank -%}
        <span>·</span>
        <span>{{ article.author }}</span>
      {%- endif -%}
    </div>
    <h1>{{ article.title }}</h1>
    {%- if article.tags.size > 0 -%}
      <div class="article__tags">
        {%- for tag in article.tags -%}
          <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="badge badge-primary">{{ tag }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </header>

  {%- if article.image -%}
    <div class="article__hero container">
      {% render 'responsive-image',
         image: article.image,
         alt: article.title,
         sizes: '(max-width: 900px) 100vw, 860px',
         widths: '860,1290,1720',
         priority: true %}
    </div>
  {%- endif -%}

  <div class="article__content container rte">
    {{ article.content }}
  </div>

  <div class="article__footer container">
    <a href="{{ blog.url }}" class="btn btn-outline">{{ 'blogs.general.back_to_blog' | t }}</a>

    {%- if settings.whatsapp_number != blank -%}
      {%- capture wa_article_text -%}
        Hola, leí "{{ article.title }}" y me gustaría más información.
      {%- endcapture -%}
      <a
        class="btn btn-accent"
        href="https://wa.me/{{ settings.whatsapp_number }}?text={{ wa_article_text | strip | url_encode }}"
        target="_blank"
        rel="noopener"
      >
        {{ 'blogs.general.ask_advisor' | t }}
      </a>
    {%- endif -%}
  </div>

  {%- if blog.comments_enabled? -%}
    <section class="article__comments container">
      <h2>{{ 'blogs.comments.title' | t }}</h2>

      {%- if article.comments_count > 0 -%}
        <ul class="comment-list">
          {%- for comment in article.comments -%}
            <li class="comment">
              <div class="comment__author">{{ comment.author }}</div>
              <time datetime="{{ comment.created_at | date: '%Y-%m-%d' }}">
                {{ comment.created_at | date: '%d %b %Y' }}
              </time>
              <div class="comment__body rte">{{ comment.content }}</div>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- form 'new_comment', article -%}
        {%- if form.errors -%}
          <p class="field__error">{{ 'blogs.comments.error' | t }}</p>
        {%- elsif form.posted_successfully? -%}
          <p class="form-success">{{ 'blogs.comments.success' | t }}</p>
        {%- endif -%}

        <div class="field-row">
          <div class="field">
            <label for="CommentAuthor">{{ 'blogs.comments.name' | t }}</label>
            <input type="text" id="CommentAuthor" name="comment[author]" value="{{ form.author }}" required>
          </div>
          <div class="field">
            <label for="CommentEmail">{{ 'blogs.comments.email' | t }}</label>
            <input type="email" id="CommentEmail" name="comment[email]" value="{{ form.email }}" required>
          </div>
        </div>
        <div class="field">
          <label for="CommentBody">{{ 'blogs.comments.message' | t }}</label>
          <textarea id="CommentBody" name="comment[body]" rows="5" required>{{ form.body }}</textarea>
        </div>
        <button type="submit" class="btn btn-primary">{{ 'blogs.comments.submit' | t }}</button>
      {%- endform -%}
    </section>
  {%- endif -%}
</article>

{% schema %}
{
  "name": "Artículo",
  "settings": [
    { "type": "checkbox", "id": "show_author", "label": "Mostrar autor", "default": true }
  ]
}
{% endschema %}
