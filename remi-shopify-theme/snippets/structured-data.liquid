{%- comment -%}
  Datos estructurados (JSON-LD) para Google: negocio local, producto,
  artículo, buscador del sitio y migas de pan.
  Uso: {% render 'structured-data' %}
{%- endcomment -%}

{%- liquid
  assign business_name = settings.business_name | default: shop.name
  assign business_phone = settings.contact_phone | default: shop.phone
  assign business_email = settings.contact_email | default: shop.email
-%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": ["Store", "MedicalBusiness"],
  "@id": {{ shop.url | append: '#business' | json }},
  "name": {{ business_name | json }},
  "url": {{ shop.url | json }},
  "description": {{ shop.description | default: business_name | strip_html | json }},
  {%- if settings.share_image %}
  "image": {{ settings.share_image | image_url: width: 1200 | prepend: 'https:' | json }},
  {%- endif %}
  {%- if business_phone != blank %}
  "telephone": {{ business_phone | json }},
  {%- endif %}
  {%- if business_email != blank %}
  "email": {{ business_email | json }},
  {%- endif %}
  {%- if shop.address.street != blank %}
  "address": {
    "@type": "PostalAddress",
    "streetAddress": {{ shop.address.street | json }},
    "addressLocality": {{ shop.address.city | json }},
    "addressRegion": {{ shop.address.province | json }},
    "postalCode": {{ shop.address.zip | json }},
    "addressCountry": {{ shop.address.country_code | default: 'MX' | json }}
  },
  {%- endif %}
  {%- if settings.business_area != blank %}
  "areaServed": {{ settings.business_area | json }},
  {%- endif %}
  {%- comment -%}
    Google necesita el horario en formato "Mo-Fr 09:00-19:00", no el texto
    que se muestra en la página. Por eso es un ajuste aparte.
  {%- endcomment -%}
  {%- if settings.business_opening_hours != blank %}
  "openingHours": [
    {%- assign opening_hours_list = settings.business_opening_hours | split: ',' -%}
    {%- for hours in opening_hours_list -%}
      {{ hours | strip | json }}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ],
  {%- endif %}
  {%- capture social_profiles -%}
    {%- if settings.social_facebook != blank %}{{ settings.social_facebook }},{% endif -%}
    {%- if settings.social_instagram != blank %}{{ settings.social_instagram }},{% endif -%}
  {%- endcapture -%}
  {%- if social_profiles != blank %}
  "sameAs": [
    {%- assign social_list = social_profiles | split: ',' -%}
    {%- for profile in social_list -%}
      {{ profile | json }}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ],
  {%- endif %}
  "priceRange": {{ settings.business_price_range | default: '$$' | json }}
}
</script>

{%- if request.page_type == 'index' -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": {{ business_name | json }},
    "url": {{ shop.url | json }},
    "potentialAction": {
      "@type": "SearchAction",
      {%- comment -%}
        El marcador {search_term_string} va fuera de la etiqueta Liquid: sus
        llaves rompen el parser si se meten dentro de un string de Liquid.
      {%- endcomment -%}
      "target": "{{ shop.url }}{{ routes.search_url }}?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  }
  </script>
{%- endif -%}

{%- if request.page_type == 'product' -%}
  {%- assign current_variant = product.selected_or_first_available_variant -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ shop.url | append: product.url | json }},
    "description": {{ product.description | strip_html | truncate: 500 | json }},
    {%- if product.vendor != blank %}
    "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
    {%- endif %}
    {%- if product.featured_media %}
    "image": [
      {%- for media in product.media limit: 5 -%}
        {%- if media.media_type == 'image' -%}
          {{ media.preview_image | image_url: width: 1200 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}
        {%- endif -%}
      {%- endfor -%}
    ],
    {%- endif %}
    {%- if current_variant.sku != blank %}
    "sku": {{ current_variant.sku | json }},
    {%- endif %}
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type": "Offer",
          "url": {{ shop.url | append: variant.url | json }},
          "price": {{ variant.price | divided_by: 100.0 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          {%- if variant.sku != blank %}
          "sku": {{ variant.sku | json }},
          {%- endif %}
          "itemCondition": "https://schema.org/NewCondition",
          "seller": { "@type": "Organization", "name": {{ business_name | json }} }
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
  </script>
{%- endif -%}

{%- if request.page_type == 'article' -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": {{ article.title | json }},
    "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
    "dateModified": {{ article.updated_at | default: article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
    {%- if article.image %}
    "image": {{ article.image | image_url: width: 1200 | prepend: 'https:' | json }},
    {%- endif %}
    "author": { "@type": "Person", "name": {{ article.author | default: business_name | json }} },
    "publisher": { "@type": "Organization", "name": {{ business_name | json }} },
    "mainEntityOfPage": { "@type": "WebPage", "@id": {{ shop.url | append: article.url | json }} }
  }
  </script>
{%- endif -%}

{%- unless request.page_type == 'index' -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Inicio", "item": {{ shop.url | json }} }
      {%- case request.page_type -%}
        {%- when 'product' -%}
          {%- if collection.title != blank -%}
          , { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ shop.url | append: collection.url | json }} }
          , { "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ shop.url | append: product.url | json }} }
          {%- else -%}
          , { "@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": {{ shop.url | append: product.url | json }} }
          {%- endif -%}
        {%- when 'collection' -%}
          , { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ shop.url | append: collection.url | json }} }
        {%- when 'article' -%}
          , { "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": {{ shop.url | append: blog.url | json }} }
          , { "@type": "ListItem", "position": 3, "name": {{ article.title | json }}, "item": {{ shop.url | append: article.url | json }} }
        {%- when 'blog' -%}
          , { "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": {{ shop.url | append: blog.url | json }} }
        {%- when 'page' -%}
          , { "@type": "ListItem", "position": 2, "name": {{ page.title | json }}, "item": {{ shop.url | append: page.url | json }} }
      {%- endcase -%}
    ]
  }
  </script>
{%- endunless -%}
